@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam sequence {
  ArrowColor #1F4E79
  ActorBorderColor #1F4E79
  ParticipantBorderColor #1F4E79
  ParticipantBackgroundColor #E8F0F8
  LifeLineBorderColor #B0B0B0
  LifeLineBackgroundColor white
}
skinparam dpi 240
hide footbox
participant "C1" as C1
participant "C2" as C2
participant "P" as P
participant "S1" as S1
participant "S2" as S2
C1 -[#1F4E79]> P : W(x=1)
P -[#1F4E79]> S1 : update
P -[#1F4E79]> S2 : update
note right of S1 #E8F0F8 : x=1
S1 -[#2E7D32]--> P : ACK
C2 -[#1F4E79]> S1 : R(x)
S1 -[#2E7D32]--> C2 : 1
C2 -[#1F4E79]> S2 : R(x)
S2 -[#C62828]--> C2 : 0
note right of S2 #E8F0F8 : x=0
S2 -[#2E7D32]--> P : ACK
P -[#1F4E79]--> C1 : OK
note over C2, S2 #FFEBEE : R1 returns 1 before R2 returns 0, and R1 ends\nbefore R2 starts: no total order of x explains\nboth reads -> linearizability violated
@enduml
