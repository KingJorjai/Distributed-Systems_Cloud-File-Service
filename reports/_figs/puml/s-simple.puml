@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam sequence {
  ArrowColor #1F4E79
  ActorBorderColor #1F4E79
  ParticipantBorderColor #1F4E79
  ParticipantBackgroundColor #E8F0F8
  LifeLineBorderColor #B0B0B0
  LifeLineBackgroundColor white
}
skinparam dpi 240
hide footbox
participant "P" as P
participant "S1" as S1
participant "S2" as S2
P -[#1F4E79]> S1 : m
note right of S1 #E8F0F8 : deliver(m)
note over P #F5F5F5 : crash
destroy P
note right of S2 #FDF1F0 : never delivers
note over P, S2 #FFEBEE : S1 delivered m, S2 never will -> agreement violated
@enduml
